<!-- What xestrata.exe and xestrata-cli.exe share: where the program's parts are, the check for the VC++ runtime, and
     setup.py run with its JSON output (setup.py's "output" section). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Xestrata.Launcher</RootNamespace>
    <AssemblyName>Xestrata.Launcher.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Places.fs" />
    <Compile Include="Runtime.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Setup.fs" />
  </ItemGroup>
</Project>
