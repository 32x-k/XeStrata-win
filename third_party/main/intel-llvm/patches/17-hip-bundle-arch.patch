@@ -1240,6 +1241,8 @@ UR_APIEXPORT ur_result_t UR_APICALL urDeviceSelectBinary(
           *pSelectedBinary = i;
           return UR_RESULT_SUCCESS;
         }
+        // a bundle without this architecture's code cannot run here
+        continue;
       }
     }
     if (!FirstBackupCandidate) {
