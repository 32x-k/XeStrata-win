if(NOT STRATA_ENABLE_XE)
    message(STATUS "DeepSeek: only the host components are enabled without SYCL")
    return()
endif()

add_library(strata_dsv41_kernels STATIC
    src/dsv41/ds4_vision.cpp
    src/dsv41/ds4_kernels.cpp
    src/dsv41/ds4_gguf.cpp
    src/dsv41/ds4_iq.cpp
    src/dsv41/ds4_iq_matrix.cpp
    src/dsv41/ds4_iq_matrix_native_f16.cpp
    src/dsv41/ds4_iq_native_f16.cpp
    src/dsv41/ds4_native_f16.cpp
    src/dsv41/ds4_tq.cpp
    src/dsv41/vendor/exl3.cpp
    src/dsv41/vendor/sampler.cpp
    src/dsv41/vendor/moe_win.cpp)
target_include_directories(strata_dsv41_kernels PUBLIC include src/dsv41 PRIVATE src third_party/main/ggml)
target_compile_features(strata_dsv41_kernels PUBLIC cxx_std_20)
target_link_libraries(strata_dsv41_kernels PUBLIC strata_dsv41_host strata_prefill strata_sycl strata_warnings)

add_executable(strata-dsv41 src/dsv41/ds4_main.cpp src/dsv41/ds4_model.cpp)
if(NOT STRATA_BUILD_ID AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/BUILD_ID")
    file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/BUILD_ID" STRATA_BUILD_ID LIMIT_COUNT 1)
endif()
if(NOT STRATA_BUILD_ID)
    execute_process(COMMAND git -C "${CMAKE_CURRENT_SOURCE_DIR}" rev-parse --short=9 HEAD
        OUTPUT_VARIABLE STRATA_BUILD_ID OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(NOT STRATA_BUILD_ID)
    set(STRATA_BUILD_ID unknown)
endif()
target_compile_definitions(strata-dsv41 PRIVATE DS4_BUILD_ID="${STRATA_BUILD_ID}")
target_compile_features(strata-dsv41 PRIVATE cxx_std_20)
target_link_libraries(strata-dsv41 PRIVATE strata_dsv41_kernels)
if(STRATA_NATIVE_EXPERTS)
    target_compile_definitions(strata-dsv41 PRIVATE STRATA_DSV41_TQ_CPU=1)
endif()

